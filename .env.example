# The Application API this MCP server calls to fetch project data
APPLICATION_API_URL=http://localhost:8000

# Must match the INTERNAL_API_KEY set in the Application API's .env — this is
# the shared secret that lets this service call the Application API's
# /internal/* endpoints without going through per-user JWT auth.
INTERNAL_API_KEY=change-this-to-a-shared-secret

# Port this MCP server listens on (streamable-http transport)
MCP_PORT=8001

# --- deploy_app / deploy_app_status tool (see deploy_tool.py) ---
# Fine-grained GitHub PAT: Contents (read/write) + Secrets (read/write),
# scoped to the vinverse26 org. In production this is set from the repo
# secret DEPLOY_GITHUB_TOKEN (see .github/workflows/deploy.yml) -- never
# commit a real value here.
GITHUB_TOKEN=github_pat_xxx
GITHUB_ORG=vinverse26
AWS_ACCOUNT_ID=503947800630
AWS_REGION=us-east-1
ROOT_DOMAIN=vinverse.ai
# Only override these if you're not using the account defaults baked
# into deploy_tool.py:
# ECS_CLUSTER=default
# ECS_EXECUTION_ROLE_ARN=arn:aws:iam::503947800630:role/service-role/ecsTaskExecutionRole
# ECS_INFRASTRUCTURE_ROLE_ARN=arn:aws:iam::503947800630:role/service-role/ecsInfrastructureRoleForExpressServices
# GITHUB_OIDC_ROLE_NAME=github-actions-vinverse-org-deploy
