# The Application API this MCP server calls to fetch project data
APPLICATION_API_URL=http://localhost:8000

# Must match the INTERNAL_API_KEY set in the Application API's .env — this is
# the shared secret that lets this service call the Application API's
# /internal/* endpoints without going through per-user JWT auth.
INTERNAL_API_KEY=change-this-to-a-shared-secret

# Port this MCP server listens on (streamable-http transport)
MCP_PORT=8001
